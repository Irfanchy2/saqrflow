# ── Supabase (required) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Modern keys (Supabase → Project Settings → API Keys). Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY still work.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. NEVER expose to the browser / prefix with NEXT_PUBLIC. Used by cron, webhooks, signed URLs, user invites.
SUPABASE_SECRET_KEY=sb_secret_...

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://app.example.com
# openssl rand -base64 32   (encrypts integration tokens saved from Settings)
SETTINGS_ENCRYPTION_KEY=
# openssl rand -hex 32      (scheduler must send: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ── WhatsApp Cloud API (leave blank to run in SANDBOX mode – nothing is sent) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
# Meta app secret: verifies webhook signatures (WHATSAPP_APP_SECRET also accepted)
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# ── Email fallback (Resend; blank = sandbox) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM="SaqrFlow <reminders@your-domain.com>"

# ── AI document reader (Settings → AI & Automation can override the provider choice; keys may also be saved there, encrypted) ──
# auto = Google Vision → OCR.Space → local OCR.  Values: auto | google_vision | ocrspace | tesseract
OCR_PROVIDER=auto
# OCR.Space (https://ocr.space/ocrapi) — server-side only. Free tier: 1 MB per file, 3 PDF pages, ~180 calls/hour.
OCR_SPACE_API_KEY=
# Optional: OCR_SPACE_ENGINE=2 (default, fast, auto language) | 1 (Arabic via "ara") | 3 (multilingual incl. Arabic, if enabled for your key)
OCR_SPACE_ENGINE=2
# OCR_SPACE_ENDPOINT=https://apipro1.ocr.space/parse/image   # PRO plans
# OCR_SPACE_MAX_BYTES=1048576                               # raise for PRO plans

# Google Cloud Vision (preferred in production). Use a service account with the "Cloud Vision API User" role:
GOOGLE_CLOUD_PROJECT_ID=
# Path to the service-account JSON (local / VM) …
GOOGLE_APPLICATION_CREDENTIALS=
# … or, on Vercel, paste the JSON (raw or base64) here instead:
GOOGLE_SERVICE_ACCOUNT_JSON=
# … or an API key restricted to the Vision API:
GOOGLE_VISION_API_KEY=

# Gemini — classification + structured extraction from OCR text (ID numbers are removed before sending by default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# AI_PROVIDER=auto   # auto | gemini | claude | rules

# Optional alternative AI reader: Anthropic Claude reads the original file itself (vision)
ANTHROPIC_API_KEY=
